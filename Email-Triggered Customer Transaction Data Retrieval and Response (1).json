      "parameters": {
        "html": "<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n  <thead>\n    <tr>\n      <th>Customer ID</th>\n      <th>Product ID</th>\n      <th>Transaction Date</th>\n      <th>Category</th>\n      <th>Region</th>\n    </tr>\n  </thead>\n\n  <tbody>\n    {{ $items().map(item => `\n      <tr>\n        <td>${item.json.Customer_ID}</td>\n        <td>${item.json.Product_ID}</td>\n        <td>${item.json.Transaction_Date}</td>\n        <td>${item.json.Category}</td>\n        <td>${item.json.Region}</td>\n      </tr>\n    `).join('') }}\n  </tbody>\n</table>\n"
